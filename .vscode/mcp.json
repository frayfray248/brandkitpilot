{
    "inputs": [
        {
            "type": "promptString",
            "id": "api-token",
            "description": "Enter your Notion API token",
            "password": true
        }
    ],
  "servers": {
    "notionApi": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${input:api-token}\", \"Notion-Version\": \"2022-06-28\" }"
      }
    }
  }
}