# =============================================================================
# Playwright Test Runner Container
# =============================================================================
#
# This container runs E2E tests with Playwright browsers pre-installed.
# Built from the official Playwright image for consistency with CI.
#
# Build: docker build -t brandkitpilot-playwright -f docker/Dockerfile.playwright .
# Run:   docker run --rm --network=host --env-file .env.test.local brandkitpilot-playwright
#
# =============================================================================

FROM mcr.microsoft.com/playwright:v1.58.1-noble

WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./

# Install dependencies
RUN npm install
RUN npm install -g @better-auth/cli@1.3.34

# Copy source code
COPY . .