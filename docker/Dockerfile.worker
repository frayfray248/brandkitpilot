FROM node:24.11.0-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy only files needed for schema generation
COPY prisma ./prisma
COPY src ./src
COPY scripts ./scripts

# Install tsx globally for TypeScript execution (required for running TypeScript files directly)
RUN npm install -g tsx

RUN mkdir -p ./generated/prisma
RUN sh ./scripts/generate.sh noauth

# Copy the rest of the source code and other files
COPY . .

# Make the start script executable
RUN chmod +x ./scripts/start-worker.sh

# Run the worker
ENTRYPOINT ["sh", "./scripts/start-worker.sh"]