
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// add your models below

// Stores user account and credit balance information.
// Role defaults to 'user'; admins have elevated access across the system.
// `tokens` tracks the user's remaining generation credits.
// `termsAccepted` records the version and timestamp of legal acceptance.
model User {
  id            String    @id @map("_id")
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?

  // app fields
  tokens            Int                @default(0)
  tokenTransactions TokenTransaction[]
  termsAccepted     TermsAccepted
  brandKits         BrandKit[]

  @@unique([email])
  @@map("user")
}

type TermsAccepted {
  timestamp DateTime @default(now())
  version   String   @default("")
}

// Tracks token purchases and consumption events for each user.
// Useful for billing, usage tracking, and audits.
// `stripeSessionId` links PURCHASE records back to the originating Stripe checkout session.
model TokenTransaction {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            TokenTransactionType
  tokens          Int
  stripeSessionId String?
  createdAt       DateTime             @default(now())

  @@unique([stripeSessionId])
  @@map("token_transaction")
}

enum TokenTransactionType {
  PURCHASE
  CONSUME
}

// Represents a completed branding kit generated by a user.
// `outputs` is an array of titled sections produced by the AI generation pipeline.
// `status` tracks the job lifecycle: PENDING → COMPLETED | FAILED.
model BrandKit {
  id      String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId  String
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  status  BrandKitStatus          @default(PENDING)
  outputs BrandKitOutputSection[]
}

type BrandKitOutputSection {
  title   String
  content String
}

enum BrandKitStatus {
  PENDING
  COMPLETED
  FAILED
}

// Defines the schema for a branding framework (e.g., StoryBrand, Brand Key).
// Used to dynamically render input forms and expected output sections.
// `inputFields` drives the wizard UI; `outputSections` defines the AI output structure.
model BrandFramework {
  id             String                        @id @default(auto()) @map("_id") @db.ObjectId
  slug           String                        @unique
  name           String
  description    String
  promptContext  String?
  inputFields    BrandFrameworkInputField[]
  outputSections BrandFrameworkOutputSection[]
  createdAt      DateTime                      @default(now())

  @@map("brand_framework")
}

type BrandFrameworkInputField {
  fieldId     String
  label       String
  type        BrandFrameworkInputType
  placeholder String
  helpText    String?
}

type BrandFrameworkOutputSection {
  title       String
  description String?
}

enum BrandFrameworkInputType {
  TEXT
  TEXTAREA
  NUMBER
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@index([identifier])
}
